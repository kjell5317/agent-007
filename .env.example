# Copy to .env and fill in what you use. Only settings without a working
# default are listed; everything else (timezone, scheduler, search tuning, …)
# has one in backend/app/config/settings.py and goes here only to override it.

# --- Deployment ---
# The defaults are for local dev (APP_ENV=dev, APP_DOMAIN=localhost); a
# deploy sets both. APP_DOMAIN is the domain Caddy serves (Let's Encrypt when
# it's real), and https://<APP_DOMAIN> is the app's public URL: OAuth
# callbacks (/auth/callback, /oauth/<provider>/callback), notification links
# and action callbacks all hang off it. BASE_URL replaces that URL, e.g.
# http://localhost:5173 for the Vite dev server in .env.dev.
# APP_ENV=prod
# APP_DOMAIN=your.domain
# BASE_URL=

# --- Database (Postgres with pgvector) ---
DATABASE_URL=postgresql+psycopg://taskagent:taskagent@localhost:5432/taskagent

# --- Secrets ---
# Fernet key for OAuth tokens at rest:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Signs the login session; required when AUTH_ALLOWED_EMAILS is set:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
# Comma-separated emails allowed to log in with Google. Empty disables auth,
# which is fine for local dev only.
AUTH_ALLOWED_EMAILS=

# --- You ---
# A street address Google Maps can geocode: commute legs and the weather
# start and end here. Empty turns commute planning off.
HOME_ADDRESS=
# Your addresses besides the connected Gmail account (aliases, forwarded
# inboxes), comma-separated: mail sent To: any of them is directed at you.
MY_EMAIL_ADDRESSES=

# --- LLM and embeddings ---
# The agents run on Anthropic (LLM_PROVIDER / LLM_MODEL override that); chat,
# subtask plans and embeddings run on Gemini.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Google: one OAuth client for login, Gmail, Calendar and Health sleep ---
# Add /auth/callback, /oauth/google/callback and /oauth/google_health/callback
# on the public URL as redirect URIs, and enable the Gmail, Calendar and Google
# Health APIs. Sleep is a separate grant (the Health API rejects tokens that
# also carry Gmail/Calendar scopes): authorize it once at
# /oauth/google_health/authorize. An External/Testing consent screen expires
# refresh tokens after 7 days; publish the app for lasting grants.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Calendars that count as busy besides the write calendar (GOOGLE_CALENDAR_ID,
# default primary), comma-separated.
GOOGLE_BUSY_CALENDAR_IDS=
# Commute routing and geocoding: enable the Distance Matrix, Routes and
# Geocoding APIs for this key.
GOOGLE_MAPS_API_KEY=

# --- Notifications (Home Assistant; NOTIFICATION_PROVIDER=ntfy or none) ---
# Home Assistant: a long-lived access token (profile → bottom). Empty URL or
# token sends nothing.
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
# ntfy: a long random topic (ntfy.sh topics are public) and, for a protected
# server, a bearer token.
NTFY_TOPIC=
NTFY_TOKEN=
# Signs notification action buttons and commute flip links; required for ntfy
# actions.
NOTIFY_ACTION_SECRET=

# --- Slack ---
# One app per workspace, keyed by a short name (the ?app= on
# /oauth/slack/authorize), with /oauth/slack/callback as its redirect URI and
# these user scopes: channels:read, channels:history, groups:read,
# groups:history, im:read, im:history, mpim:read, mpim:history, users:read.
SLACK_APPS={"primary":{"client_id":"","client_secret":""}}

# --- GitHub: read-only issue/PR search ---
# A fine-grained token with read-only Issues, Pull requests and Metadata on the
# repos to search. Empty turns GitHub search off.
GITHUB_TOKEN=

# --- kotx (coding-agent API) ---
# Empty URL or token turns the kotx proxy and poll off. The webhook secret must
# match kotx's (X-Kotx-Signature); without it the poll still catches up.
KOTX_BASE_URL=
KOTX_API_TOKEN=
KOTX_WEBHOOK_SECRET=

# --- Langfuse (LLM tracing; both keys empty = off) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
